#include <stdio.h>
\\(4.2)Receba dois números e um caractere representando uma operação matemática (+,,, /). Utilize a estrutura switch/case para executar e exibir o resultado da operação.
int main()
{
float num1, num2;
char operacao;

    printf("Digite dois numeros: ");
    scanf( "%f %f", &num1, &num2);
   
    printf("Digite a operacao (+, -, *, /): ");
    scanf(" %c", &operacao);


switch(operacao)
{
case '+':

    printf("%f",num1 + num2);
    break;

case '-':
    printf("%f", num1 - num2);
    break;

case '*':
    printf("%f", num1 * num2);
    break;
 case '/':
    printf("%f", num1 / num2);
    break;    





}
}
